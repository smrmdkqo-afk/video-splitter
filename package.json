    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:media": "node --experimental-strip-types scripts/verify-media.ts"
  },
  "dependencies": {
    "mediabunny": "1.55.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "engines": { "node": ">=24" }
}
